<Project Sdk="Microsoft.NET.Sdk">

  <!--
    INFRASTRUCTURE — adapters for the ports Application declares.

    This is the only project that is allowed to know Azure exists. Every Azure
    SDK package is quarantined here so that swapping AI Search for another
    retrieval engine, or Blob for another store, is a change to one project and
    zero business rules.

    It references Application (to implement its interfaces) and Domain (its
    repositories return entities). It must never be referenced *by* Application.
  -->
  <ItemGroup>
    <ProjectReference Include="..\KnowledgeAssistant.Application\KnowledgeAssistant.Application.csproj" />
    <ProjectReference Include="..\KnowledgeAssistant.Domain\KnowledgeAssistant.Domain.csproj" />
  </ItemGroup>

  <ItemGroup Label="Azure">
    <PackageReference Include="Azure.Identity" />
    <PackageReference Include="Azure.Storage.Blobs" />
    <PackageReference Include="Azure.Search.Documents" />
    <PackageReference Include="Azure.AI.OpenAI" />
    <PackageReference Include="Azure.AI.Projects" />
    <PackageReference Include="Microsoft.Extensions.Azure" />
  </ItemGroup>

  <ItemGroup Label="Hosting primitives">
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
    <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" />
    <PackageReference Include="Microsoft.Extensions.Http" />
  </ItemGroup>

</Project>
