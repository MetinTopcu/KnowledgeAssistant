<Project Sdk="Microsoft.NET.Sdk">

  <!--
    INFRASTRUCTURE — adapters for the ports Application declares.

    This is the only project that is allowed to know Azure exists. Every Azure
    SDK package is quarantined here so that swapping AI Search for another
    retrieval engine, or Blob for another store, is a change to one project and
    zero business rules.

    It references Application (to implement its interfaces) and Domain (its
    repositories return entities). It must never be referenced *by* Application.
  -->
  <!--
    OPENAI001 marks the OpenAI Responses API as evaluation-only: it is the type
    set the Foundry agent data plane is built on (ResponseTool, ResponseItem,
    ResponseResult), so the agent adapter cannot be written without touching it.
    TreatWarningsAsErrors is on solution-wide, so the choice is to acknowledge the
    diagnostic here or not to have the feature.

    Scoped to this project deliberately, and this project is the only one that
    could ever hit it — Application and Domain reference no vendor SDK at all, and
    the architecture tests enforce that. What is suppressed is a stability warning,
    not a correctness one: these types can change shape in a future OpenAI package,
    which is a reason to pin the version (Directory.Packages.props does) and to
    expect the agent adapter to need revisiting on a major bump.
  -->
  <PropertyGroup>
    <NoWarn>$(NoWarn);OPENAI001</NoWarn>
  </PropertyGroup>

  <!-- See the Application project for why the adapters are internal and tested. -->
  <ItemGroup Label="Test visibility">
    <InternalsVisibleTo Include="KnowledgeAssistant.Tests.Unit" />
    <InternalsVisibleTo Include="KnowledgeAssistant.Tests.Integration" />
  </ItemGroup>

  <!--
    Health checks for this layer's own dependencies. Abstractions supplies
    IHealthCheck; the non-abstractions package supplies AddHealthChecks(), which
    this layer's composition root calls. Neither drags in ASP.NET Core — mapping
    the endpoints stays entirely in the API.
  -->
  <ItemGroup Label="Diagnostics">
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\KnowledgeAssistant.Application\KnowledgeAssistant.Application.csproj" />
    <ProjectReference Include="..\KnowledgeAssistant.Domain\KnowledgeAssistant.Domain.csproj" />
  </ItemGroup>

  <ItemGroup Label="Azure">
    <PackageReference Include="Azure.Identity" />
    <PackageReference Include="Azure.Storage.Blobs" />
    <PackageReference Include="Azure.Search.Documents" />
    <PackageReference Include="Azure.AI.DocumentIntelligence" />
    <PackageReference Include="Azure.AI.Projects" />
    <PackageReference Include="Azure.AI.Projects.Agents" />
    <PackageReference Include="Azure.AI.Extensions.OpenAI" />
    <PackageReference Include="OpenAI" />
    <PackageReference Include="Microsoft.Extensions.Azure" />
  </ItemGroup>

  <!--
    Local PDF text extraction, used when Document Intelligence is not
    configured. Managed code with no native binaries, so it runs unchanged on a
    Linux container and a Windows laptop.
  -->
  <ItemGroup Label="Document processing">
    <PackageReference Include="PdfPig" />
  </ItemGroup>

  <!--
    Retry and backoff for the embedding client. Confined to this project like
    every other adapter concern: Application declares what it needs and knows
    nothing about how many times a call was attempted.
  -->
  <ItemGroup Label="Resilience">
    <PackageReference Include="Polly.Core" />
  </ItemGroup>

  <ItemGroup Label="Hosting primitives">
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
    <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" />
    <PackageReference Include="Microsoft.Extensions.Http" />
  </ItemGroup>

</Project>
