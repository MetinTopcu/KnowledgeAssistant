# Every variable this client reads. All are required and validated at startup
# by src/shared/config/env.ts — a missing one fails the app immediately rather
# than on the first request that needs it.
#
# Nothing here is a secret. The browser can read every VITE_ variable, so no
# credential may ever be placed in this file. The API authenticates to Azure
# with a managed identity; the client authenticates to the API, never to Azure.

# Origin the API is served from. "/" means same origin, which is what both the
# dev proxy and a co-hosted deployment provide. Use an absolute origin when the
# client is hosted separately from the API.
VITE_API_BASE_URL=/

# development | staging | production — shown in the status bar.
VITE_ENVIRONMENT=development

# Azure region, shown beside the environment.
VITE_AZURE_REGION=francecentral

# Build identifier, quoted in bug reports alongside the correlation id.
VITE_APP_VERSION=0.1.0

# Milliseconds before an in-flight request is abandoned. Agent runs are the
# slow path: the agent may search several times before it answers.
VITE_API_TIMEOUT_MS=120000
