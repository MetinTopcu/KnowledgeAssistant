<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!--
    Repo-scoped package sources.

    <clear /> deliberately discards whatever feeds happen to be registered on
    the developer's machine, so a restore produces the same graph on a laptop
    and on a build agent.

    packageSourceMapping is required by Central Package Management once more
    than one feed is in play, and it is worth having on its own merits: it is
    the standard mitigation for dependency-confusion attacks, where a public
    feed serves a malicious package under an internal name. When you add a
    private feed, map only your own prefix to it — never '*'.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <!-- <add key="internal" value="https://pkgs.dev.azure.com/<org>/_packaging/<feed>/nuget/v3/index.json" /> -->
  </packageSources>

  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <!--
    <packageSource key="internal">
      <package pattern="Contoso.*" />
    </packageSource>
    -->
  </packageSourceMapping>

</configuration>
