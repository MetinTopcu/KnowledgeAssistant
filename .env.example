#  KnowledgeAssistant — environment template
#
#  Copy to .env, which is gitignored:
#
#      cp .env.example .env
#
#  PUT NO REAL SECRET IN THIS FILE. It is the one file of the pair that git
#  tracks, so anything pasted here is committed. (.env.example is re-included by
#  an explicit negation in .gitignore precisely because `.env.*` would otherwise
#  hide it — see the comment there before editing those rules.)
#
#  ── There are no credentials below, and that is the design ──────────────────
#
#  Every Azure dependency authenticates with Entra ID through
#  DefaultAzureCredential: managed identity in Azure, your own az-CLI login on a
#  laptop. There is no key, connection string, or client secret anywhere in this
#  service, which is the strongest guarantee that none is leaked — the secret
#  does not exist. Everything below is an endpoint, a resource name, or a tuning
#  value.
#
#  ── Key names use double underscores ────────────────────────────────────────
#
#  ASP.NET Core maps `__` to configuration nesting, so Azure__Search__Endpoint
#  here is "Azure:Search:Endpoint" in appsettings.json. Single underscores do
#  NOT nest, and a mistyped key binds nothing and fails at startup with a
#  message naming the setting it could not find.
#
#  See CONFIGURATION.md for provider precedence and the RBAC roles required.

# ─── Host ───────────────────────────────────────────────────────────────────
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:8080

# ─── How the container authenticates to Azure ───────────────────────────────
# There is no key to put here, so docker-compose mounts your existing az-CLI
# login into the container read-only and DefaultAzureCredential picks it up.
# Point this at the directory `az` writes its token cache to:
#
#     Windows        AZURE_CONFIG_DIR=C:\Users\<you>\.azure
#     macOS / Linux  AZURE_CONFIG_DIR=/home/<you>/.azure
#
# Run `az login` first. Without this the container starts and serves /health/live,
# but every Azure call fails with CredentialUnavailable — which is the honest
# outcome, not a bug.
AZURE_CONFIG_DIR=

# ─── Azure Storage — where uploaded documents are kept ──────────────────────
# The account URI, not a connection string: connection strings embed a key.
Azure__Storage__ServiceUri=https://<your-account>.blob.core.windows.net/
Azure__Storage__DocumentsContainer=documents

# ─── Azure AI Search — the document and chunk indexes ───────────────────────
Azure__Search__Endpoint=https://<your-search>.search.windows.net/
Azure__Search__IndexName=knowledge-index
Azure__Search__ChunkIndexName=knowledge-chunks

# ─── Azure AI Foundry — embeddings, chat, and the agent ─────────────────────
# Deployment names, not model names. Using the model name where Azure expects
# the deployment is the most common cause of a 404 from correct-looking config.
Azure__AiFoundry__Endpoint=https://<your-foundry>.services.ai.azure.com/
Azure__AiFoundry__ChatDeploymentName=gpt-4o-mini
Azure__AiFoundry__EmbeddingDeploymentName=text-embedding-3-small
Azure__AiFoundry__EmbeddingModelName=text-embedding-3-small
Azure__AiFoundry__EmbeddingDimensions=1536

# ─── Azure AI Foundry agent ─────────────────────────────────────────────────
# All optional. Empty ProjectEndpoint falls back to the endpoint above, which is
# correct only while the account hosts a single project.
#
# PIN THE VERSION IN PRODUCTION. Left empty, the running process resolves or
# creates an agent version on the first question, which needs the
# "Azure AI Project Manager" write role. Pinning drops that role — the version
# to pin is printed in the log when one is created.
Azure__AiFoundry__Agent__ProjectEndpoint=
Azure__AiFoundry__Agent__Name=knowledge-assistant
Azure__AiFoundry__Agent__Version=

# ─── Document Intelligence (optional) ───────────────────────────────────────
# Empty selects the local PdfPig extractor. Set it to OCR scanned documents.
Azure__DocumentIntelligence__Endpoint=

# ─── Managed identity ───────────────────────────────────────────────────────
# Empty means the system-assigned identity. Set only for a user-assigned one.
# This is a client id, not a secret.
Azure__Credential__ManagedIdentityClientId=

# ─── Observability ──────────────────────────────────────────────────────────
# The Application Insights connection string is NOT a read credential — it
# authorises ingestion, not query — but anyone holding it can write into your
# workspace, so supply it by environment or Key Vault rather than committing it.
Observability__AzureMonitor__ConnectionString=

# Local OTLP collector. docker-compose points this at the Aspire dashboard.
Observability__Otlp__Endpoint=
