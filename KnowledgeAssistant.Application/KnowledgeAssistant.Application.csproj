<Project Sdk="Microsoft.NET.Sdk">

  <!--
    APPLICATION — use-case orchestration (CQRS).

    Depends on Domain only. It declares the outbound ports it needs
    (Interfaces/) but never learns who implements them. Note that the packages
    below are all abstraction-only: DI and Logging *.Abstractions, never the
    concrete hosting types. That keeps this layer host-agnostic and trivially
    unit-testable without a WebApplicationFactory.

    TargetFramework / Nullable / ImplicitUsings are inherited from
    Directory.Build.props at the repo root.
  -->
  <!--
    Handlers, validators, and the prompt builder are internal on purpose: nothing
    outside this assembly should construct them, and the only legitimate entry
    point is the mediator. Tests need them anyway, and the alternatives are worse
    — making them public to test them would widen the API surface for no
    consumer, and reaching them by reflection defeats the compiler, so a renamed
    method fails at run time instead of in the build.
  -->
  <ItemGroup Label="Test visibility">
    <InternalsVisibleTo Include="KnowledgeAssistant.Tests.Unit" />
    <InternalsVisibleTo Include="KnowledgeAssistant.Tests.Integration" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\KnowledgeAssistant.Domain\KnowledgeAssistant.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MediatR" />
    <PackageReference Include="FluentValidation" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />

    <!--
      Telemetry instrumentation, and the one place this project departs from
      "abstractions only". Both are Microsoft.* / BCL, not vendor SDKs:

        System.Diagnostics.DiagnosticSource supplies ActivitySource and Meter —
        the types instrumented code calls. OpenTelemetry does not define that API
        on .NET; it subscribes to it. So this layer is fully traced and metered
        while remaining free of any telemetry vendor, and the fitness tests in
        Tests.Architecture still pass unchanged.

        Microsoft.Extensions.Diagnostics supplies AddMetrics(), so this layer's
        composition root can register the IMeterFactory its instruments need
        rather than requiring every host to know that.
    -->
    <PackageReference Include="System.Diagnostics.DiagnosticSource" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics" />
  </ItemGroup>

</Project>
