<Project>

  <!--
    Central Package Management (CPM).

    Every version in the solution is declared exactly once, here. Projects
    reference packages by name only. This removes the single most common source
    of enterprise dependency drift: two projects silently binding different
    versions of the same assembly.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <!--
    Application layer.

    NOTE ON MediatR LICENSING: 12.4.1 is the last Apache-2.0 release. Version 13
    and later ship a proprietary LICENSE.md and require a paid commercial
    licence above a revenue threshold. This scaffold pins the OSS release
    deliberately. Moving to 14.x is a procurement decision, not a version bump.
  -->
  <ItemGroup Label="Application">
    <PackageVersion Include="MediatR" Version="12.4.1" />
    <PackageVersion Include="FluentValidation" Version="12.1.1" />
    <PackageVersion Include="FluentValidation.DependencyInjectionExtensions" Version="12.1.1" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.10" />

    <!--
      INSTRUMENTATION, NOT A TELEMETRY VENDOR. This package supplies
      System.Diagnostics.ActivitySource and System.Diagnostics.Metrics.Meter —
      the BCL types that .NET code calls to emit spans and measurements. The
      OpenTelemetry SDK is only a *listener* for them, and it lives in the API
      project. That separation is what lets the Application layer be fully
      instrumented while staying free of any telemetry vendor: remove every
      OpenTelemetry package from this solution and Application still compiles.

      It was already present transitively at this exact version; declaring it
      makes the dependency deliberate rather than inherited.
    -->
    <PackageVersion Include="System.Diagnostics.DiagnosticSource" Version="10.0.10" />

    <!-- Supplies AddMetrics(), which registers the IMeterFactory the metrics
         types resolve. Microsoft.Extensions.*, not a vendor SDK. -->
    <PackageVersion Include="Microsoft.Extensions.Diagnostics" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup Label="Infrastructure — Azure">
    <PackageVersion Include="Azure.Identity" Version="1.21.0" />
    <PackageVersion Include="Azure.Storage.Blobs" Version="12.29.1" />
    <PackageVersion Include="Azure.Search.Documents" Version="12.0.0" />
    <PackageVersion Include="Azure.AI.DocumentIntelligence" Version="1.0.0" />
    <PackageVersion Include="Azure.AI.OpenAI" Version="2.1.0" />
    <PackageVersion Include="Azure.AI.Projects" Version="2.0.1" />

    <!--
      The agent surface, split across three packages by the SDK rather than by us.
      Azure.AI.Projects carries the project client; Azure.AI.Projects.Agents carries
      the agent *definition* control plane (create a version, attach a tool);
      Azure.AI.Extensions.OpenAI carries the *data* plane, which is the OpenAI
      Responses API pointed at a project. Both of the latter arrive transitively
      through Azure.AI.Projects at exactly these versions, so declaring them adds
      no resolution — it makes a dependency the Infrastructure code names directly
      into one this file records, which is the whole point of CPM.

      OpenAI is declared for the same reason and is the version this graph already
      resolved to: Azure.AI.Extensions.OpenAI requires 2.9.1 and Azure.AI.OpenAI
      2.1.0 requires only 2.1.0, so 2.9.1 wins whether or not it is written down.
      Written down, a future package that would quietly move it fails the restore
      instead.
    -->
    <PackageVersion Include="Azure.AI.Projects.Agents" Version="2.0.0" />
    <PackageVersion Include="Azure.AI.Extensions.OpenAI" Version="2.0.0" />
    <PackageVersion Include="OpenAI" Version="2.9.1" />

    <PackageVersion Include="Microsoft.Extensions.Azure" Version="1.14.0" />
  </ItemGroup>

  <!--
    NOTE ON PACKAGE IDENTITY: the package id is "PdfPig"; "UglyToad.PdfPig" is
    the *namespace*. A package published under the namespace-shaped id also
    exists on nuget.org, with no project URL, an authors field that merely
    repeats its own id, and a "-custom" version suffix. It is not the library
    maintained at github.com/UglyToad/PdfPig. Referencing the namespace by
    mistake is exactly the substitution NuGet.config's source mapping is meant
    to make hard, so the correct id is recorded here explicitly.

    Apache-2.0, consistent with this solution's preference for permissively
    licensed dependencies. The obvious alternative, iText, is AGPL — which would
    oblige this service's source to be offered to every user of it, or a
    commercial licence to be bought.
  -->
  <ItemGroup Label="Infrastructure — Document processing">
    <PackageVersion Include="PdfPig" Version="0.1.15" />
  </ItemGroup>

  <!--
    Polly.Core rather than the Polly metapackage: it is the v8 resilience
    pipeline API on its own, without the v7 Policy/PolicyWrap surface that
    package also carries for backwards compatibility. The namespace is still
    Polly; what is excluded is a deprecated API nothing here should be written
    against.
  -->
  <ItemGroup Label="Infrastructure — Resilience">
    <PackageVersion Include="Polly.Core" Version="8.7.0" />
  </ItemGroup>

  <!--
    The Microsoft.Extensions.* family is pinned to 10.0.x even though the apps
    target net9.0. These packages multi-target and run happily on net9.0; the
    10.x floor is forced transitively by Microsoft.Extensions.Azure and
    Serilog.AspNetCore. Pinning them explicitly (rather than letting NuGet
    resolve) is what CentralPackageTransitivePinningEnabled is for: one version
    of each assembly across the whole solution, chosen by us, not inferred.

    Microsoft.AspNetCore.* is the exception — it stays on 9.0.x because
    ASP.NET Core packages are framework-bound and 10.x requires net10.0.
  -->
  <ItemGroup Label="Infrastructure — Hosting primitives">
    <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.10" />
    <!-- Supplies OptionsBuilder.ValidateDataAnnotations, which drives ValidateOnStart. -->
    <PackageVersion Include="Microsoft.Extensions.Options.DataAnnotations" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup Label="Api">
    <PackageVersion Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="9.0.18" />
  </ItemGroup>

  <!--
    Observability.

    NOTE ON THE APPLICATION INSIGHTS CHOICE: this uses the OpenTelemetry
    exporter, not the classic Microsoft.ApplicationInsights.AspNetCore SDK. The
    classic SDK is in maintenance and carries its own parallel collection
    pipeline, which would duplicate every span the OpenTelemetry instrumentation
    already produces. The exporter is the path Microsoft documents for new work,
    and it authenticates with Entra ID — so, like every other Azure dependency
    here, there is no instrumentation key to keep out of source control.

    These live only in the API project. Nothing below is referenced by
    Application, Domain, or Infrastructure; see the Application group for why.
  -->
  <ItemGroup Label="Observability">
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.17.0" />
    <PackageVersion Include="Azure.Monitor.OpenTelemetry.Exporter" Version="1.8.3" />
  </ItemGroup>

  <!--
    Health checks. The abstractions package is what Infrastructure references so
    it can define checks for its own dependencies without taking a dependency on
    ASP.NET Core; the hosting side of health checks is in the framework and is
    used only by the API.
  -->
  <ItemGroup Label="Health">
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks.Abstractions" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="10.0.10" />
  </ItemGroup>

  <!--
    Tests.

    NOTE ON FluentAssertions LICENSING: 7.2.2 is the last Apache-2.0 release.
    Version 8 and later ship under a file-based Xceed licence that requires a
    paid commercial licence outside open-source use. This is the same decision
    already taken for MediatR (pinned to the last Apache-2.0 release) and against
    iText (AGPL). Moving to 8.x is a procurement decision, not a version bump.

    Microsoft.AspNetCore.Mvc.Testing tracks the app's framework, so it stays on
    9.0.x for the same reason Microsoft.AspNetCore.OpenApi does: ASP.NET Core
    packages are framework-bound and 10.x requires net10.0.
  -->
  <ItemGroup Label="Tests">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="FluentAssertions" Version="7.2.2" />
    <PackageVersion Include="NetArchTest.Rules" Version="1.3.2" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="9.0.18" />
  </ItemGroup>

</Project>
